<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bạn bè</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/public/styles.css" />
  </head>
  <body>
    <div class="container py-4">
      <header class="d-flex align-items-center justify-content-between mb-4">
        <h1 class="fw-bold">Bạn bè</h1>
        <div>Xin chào, <b><%= user.displayName %></b></div>
      </header>

      <main class="grid2">
        <section class="card card-3d p-4">
          <h3 class="h5">Gửi lời mời kết bạn</h3>
          <form class="row g-3" method="post" action="/friends/request">
            <div class="col-12">
              <label class="form-label">Tên đăng nhập</label>
              <input class="form-control" name="username" placeholder="vd: kiencuong" required />
            </div>
            <div class="col-12"><button class="btn btn-primary btn-3d" type="submit">Gửi lời mời</button></div>
          </form>
        </section>

        <section class="card card-3d p-4">
          <h3 class="h5">Lời mời kết bạn</h3>
          <div class="list-group">
            <% me.friendRequests.forEach(fr => { %>
              <div class="list-group-item d-flex justify-content-between align-items-center">
                <span><b><%= fr.displayName %></b> <small class="text-muted">(@<%= fr.username %>)</small></span>
                <form method="post" action="/friends/accept" class="m-0">
                  <input type="hidden" name="id" value="<%= fr._id %>" />
                  <button class="btn btn-success btn-sm" type="submit">Chấp nhận</button>
                </form>
              </div>
            <% }) %>
          </div>
        </section>

        <section class="card card-3d p-4" style="grid-column: span 2;">
          <h3 class="h5">Danh sách bạn bè</h3>
          <div class="list-group">
            <% me.friends.forEach(f => { %>
              <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="/dm/<%= [user.id, f._id].sort().join('') %>">
                <span><b><%= f.displayName %></b> <small class="text-muted">(@<%= f.username %>)</small></span>
                <span class="text-primary"><i class="bi bi-chat-dots"></i> Nhắn tin/Gọi video</span>
              </a>
            <% }) %>
          </div>
        </section>
      </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
